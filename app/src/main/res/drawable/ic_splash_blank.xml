<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately invisible: the start-up window shows only the background colour, so the first thing
     drawn is the app's own splash (LaunchPopup) and there is just one splash screen.
     It must still contain one path: Android refuses to load a <vector> with none ("no path defined"),
     which crashes the app at launch. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h24v24h-24z" />
</vector>
